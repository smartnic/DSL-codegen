struct packet {
    vector int8 ttl;
    vector int32 random;
};

vector_width 256;

packet.ttl--;
packet.ttl = packet.ttl - 1;
vector sum = packet.random + packet.random;

vector diff = packet.random - packet.random;
vector chain = packet.random + packet.random - packet.random;
packet.random += packet.random;
